# PostgreSQL
POSTGRES_DB=schema_risk
POSTGRES_USER=schema_risk
POSTGRES_PASSWORD=schema_risk

# Spring datasource inside Docker network
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/schema_risk
SPRING_DATASOURCE_USERNAME=schema_risk
SPRING_DATASOURCE_PASSWORD=schema_risk

# Registry-first mode
SCHEMA_CATALOG_MODE=confluent
CONFLUENT_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Optional auth for remote Schema Registry
CONFLUENT_SCHEMA_REGISTRY_USERNAME=
CONFLUENT_SCHEMA_REGISTRY_PASSWORD=
CONFLUENT_SCHEMA_REGISTRY_API_KEY=
CONFLUENT_SCHEMA_REGISTRY_API_SECRET=
